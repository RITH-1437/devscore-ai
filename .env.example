APP_NAME="GitRadar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=devscore_ai
DB_USERNAME=root
DB_PASSWORD=

# Session: database (default, no Redis) | redis (optional, faster multi-server setups)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue: database (default, no Redis) | redis (faster job dispatch for sync & AI analysis)
# QUEUE_CONNECTION=failover tries redis first, then falls back to database if Redis is down
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330

# Cache: file (default, no Redis) | redis (in-memory speed) | failover (redis → database → file)
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis (optional — only required when using redis/failover drivers above)
# REDIS_CLIENT: predis (pure PHP, works on Windows) | phpredis (ext-redis, faster on Linux/macOS)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_URL=
# REDIS_USERNAME=
# REDIS_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GitHub OAuth - Get from https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# OpenRouter AI API - Get from https://openrouter.ai/keys
# Used when GEMINI_API_KEY is not set (fallback provider).
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional: override primary model (must be a valid OpenRouter slug).
# Default chain tries google/gemini-2.0-flash-exp:free first, then slower fallbacks.
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_TIMEOUT=45
OPENROUTER_CONNECT_TIMEOUT=10
OPENROUTER_TOTAL_BUDGET=240
OPENROUTER_RETRY_TIMES=0
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_VERIFY_MODELS=true

# Google Gemini API - Get from https://aistudio.google.com/apikey
# When set, repository analysis uses direct Gemini instead of OpenRouter.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=45
GEMINI_CONNECT_TIMEOUT=10
GEMINI_RETRY_TIMES=0
GEMINI_MAX_TOKENS=2048
